Options -MultiViews

# 301 redirects from old HTML pages to new React routes
Redirect 301 /ourteam.html /teams
Redirect 301 /ourteam/ourteam.html /teams
Redirect 301 /activities.html /activities
Redirect 301 /contact.html /contact
Redirect 301 /about.html /about
Redirect 301 /index.html /

# SPA fallback — send all non-file requests to index.html
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]
